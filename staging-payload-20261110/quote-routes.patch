 def install(router: Any, connect: Callable, current: Callable, write_guard: Callable) -> None:
     """Called once by commerce_gateway after its existing dependencies exist."""
 
+    @router.post('/sourcing/quote-drafts', status_code=201)
+    def create_draft(payload: QuoteDraftInput, session: sqlite3.Row = Depends(write_guard)) -> dict:
+        with closing(connect()) as db:
+            try:
+                return create_quote_draft(
+                    db, user_id=session['user_id'], organization_id=session['organization_id'],
+                    idempotency_key=payload.idempotency_key,
+                    destination_country=payload.destination_country, locale=payload.locale,
+                    lines=[line.dict() for line in payload.lines],
+                )
+            except PermissionError as exc:
+                raise HTTPException(403, str(exc)) from exc
+            except ValueError as exc:
+                raise HTTPException(422, str(exc)) from exc
+            except LookupError as exc:
+                raise HTTPException(404, str(exc)) from exc
+
+    @router.get('/sourcing/quote-drafts')
